CREATE DATABASE IF NOT EXISTS Bakery;
USE Bakery;
CREATE TABLE IF NOT EXISTS Locations(
    Branch_Number INT PRIMARY KEY AUTO_INCREMENT,
    Address VARCHAR(100) NOT NULL,
    City VARCHAR(50) NOT NULL,
    State CHAR(2) NOT NULL,
    Opening_Hours VARCHAR(100),
    Phone_Number VARCHAR(25)
);

CREATE TABLE IF NOT EXISTS Categories(
    Category_Name VARCHAR(50) PRIMARY KEY,
    Number_of_Products INT NOT NULL DEFAULT 0
);

CREATE TABLE IF NOT EXISTS Employees(
    Employee_ID INT PRIMARY KEY AUTO_INCREMENT,
    Name VARCHAR(100) NOT NULL,
    Phone_Number VARCHAR(25),
    Address VARCHAR(150),
    Salary DECIMAL(10, 2) NOT NULL,
    Branch_Number INT NOT NULL,
    CONSTRAINT employees_fk_branch_num FOREIGN KEY (Branch_Number) REFERENCES Locations(Branch_Number)
);

CREATE TABLE IF NOT EXISTS Products(
    Product_Name VARCHAR(100) PRIMARY KEY,
    Category_Name VARCHAR(50) NOT NULL,
    Price DECIMAL(10, 2) NOT NULL,
    CONSTRAINT products_fk_category FOREIGN KEY (Category_Name) REFERENCES Categories(Category_Name)
);

CREATE TABLE IF NOT EXISTS Ingredients(
    Product_Name VARCHAR(100) PRIMARY KEY,
    Ingredients TEXT NOT NULL,
    Equipment VARCHAR(150),
    CONSTRAINT ingedients_fk_product FOREIGN KEY (Product_Name) REFERENCES Products(Product_Name)
);

CREATE TABLE IF NOT EXISTS Orders(
    Order_ID INT PRIMARY KEY AUTO_INCREMENT,
    Customer_Name VARCHAR(100) NOT NULL,
    Customer_Phone_Number VARCHAR(25),
    Order_Total DECIMAL(10, 2) NOT NULL,
    Date DATE NOT NULL,
    Branch_Number INT NOT NULL,
    CONSTRAINT orders_fk_branch_num FOREIGN KEY (Branch_Number) REFERENCES Locations(Branch_Number)
);

CREATE TABLE IF NOT EXISTS Order_Items(
    Order_ID INT NOT NULL,
    Product_Name VARCHAR(100) NOT NULL,
    Quantity INT NOT NULL DEFAULT 1,
    CONSTRAINT order_items_pk PRIMARY KEY (Order_ID, Product_Name),
    CONSTRAINT order_items_fk_odrder_id FOREIGN KEY (Order_ID) REFERENCES Orders(Order_ID),
    CONSTRAINT odrer_items_fk_products FOREIGN KEY (Product_Name) REFERENCES Products(Product_Name)
);

